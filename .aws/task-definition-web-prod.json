{
  "family": "webserver-prod",
  "containerDefinitions": [
    {
      "name": "webserver-prod",
      "image": "617001639586.dkr.ecr.us-east-1.amazonaws.com/",
      "cpu": 0,
      "portMappings": [
        {
          "name": "webserver-80-tcp",
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-create-group": "true",
          "awslogs-group": "/ecs/webserver-prod",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost/ || exit 1"],
        "interval": 60,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 300
      }
    }
  ],
  "executionRoleArn": "arn:aws:iam::617001639586:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::617001639586:role/webserver-fargate-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  }
}
