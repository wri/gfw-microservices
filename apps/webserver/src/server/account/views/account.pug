extends ../../core/views/layout.pug
block head
  link(href=accountcss, rel='stylesheet')
  script(src=common)
block content
  div#account-mount
  //- script(src=accountjs, async)
  link(rel='stylesheet', href='https://js.arcgis.com/4.20/esri/css/main.css')
  script.
    var classificationsData = !{JSON.stringify(classifications)};
    var commoditiesData = !{JSON.stringify(commodities)};
    var geographiesData = !{JSON.stringify(geographies)};
    var titlesData = !{JSON.stringify(titles)};
  script(src='https://js.arcgis.com/4.20/', async)
  script.
    var makePath = function makePath (base, path) {
      var position = base.length - 1;
      return !path ?
        (base.indexOf('/', position) !== position ? base + '/' : base) :
        (base.indexOf('/', position) !== position ?
          base + '/' + path :
          base + path
        )
    };
    var base = makePath(location.href.replace(/\/[^/]+$/, ''));
    var dojoConfig = {
      parseOnLoad: false,
      async: true,
      has: {
        "esri-promise-compatibility": 1
      },
      packages: [
        { name: 'common', location: makePath(base, 'common') }
      ],
      deps: ['dojo/domReady!'],
      callback: function(){
        require(['#{accountjs}']);
      }
    };
