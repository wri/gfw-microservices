### Download List locations CSV based on filters provided
POST https://localhost:8443/locations/downloadingSelectedLocations
Content-Type: application/json
Cookie: gfwpro.globalforestwatch.org={{gfwpro_token}}
# =======================================
# List name - ebpack v5 test
# List ID - 2038
# LocationIds and LocationLogic = nullify => state, subState, subState
# =======================================

{
  "listID": 2038,
  "orderType": "desc",
  "sortByAttribute": "location_id",
  "country": "Brazil",
  "state": "Bahia",
  "subState": "Barreiras",
  "analysisAreaMin":0,
  "analysisAreaMax":null,
  "columnsToReturn": "Location Name,Commodity,State,Certification",
  "LocationIds": "1,3,64",
  "LocationLogic": "NOT IN"
}

### Edit List Locations
POST https://localhost:8443/locations/editLocations
Content-Type: application/json
Cookie: gfwpro.globalforestwatch.org={{gfwpro_token}}
# =======================================
# List name - webpack v5 test
# List ID - 2038
# Excluded columns - ['Location Name', 'Investment Name', 'Latitude', 'Longitude', 'Analysis Area', 'Analysis Radius', 'Commodity', 'Location Classification']
# =======================================

{
  "list_id": 2038,
  "location_ids": [30, 34, 42],
  "attributes": [
    {"list_id": 2038, "location_id": 30, "Type of Investment": "old investment", "Investment Name": "30"},
    {"list_id": 2038, "location_id": 34, "Type of Investment": "old investment"},
    {"list_id": 2038, "location_id": 42, "Type of Investment": "old investment"}
  ]
}

### Edit List Locations - no Location IDs
POST https://localhost:8443/locations/editLocations
Content-Type: application/json
Cookie: gfwpro.globalforestwatch.org={{gfwpro_token}}
# =======================================
# List name - webpack v5 test
# List ID - 2038
# Excluded columns - ['Location Name', 'Investment Name', 'Latitude', 'Longitude', 'Analysis Area', 'Analysis Radius', 'Commodity', 'Location Classification']
# =======================================

{
  "list_id": 2038,
  "attributes": [
    {"list_id": 2038, "location_id": 30, "Type of Investment": "old investment", "Investment Name": "30"},
    {"list_id": 2038, "location_id": 34, "Type of Investment": "renewal"},
    {"list_id": 2038, "location_id": 42, "Type of Investment": "new investment"}
  ]
}

### Edit List Locations - no Location IDs and wrong list_id
