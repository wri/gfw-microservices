### Get all feature flags
GET https://localhost:8443/api/feature-flags
Content-Type: application/json
Cookie: gfwpro.globalforestwatch.org={{gfwpro_token}}

### Get feature flags by flagId
GET https://localhost:8443/api/feature-flag/feature-flag
Content-Type: application/json
Cookie: gfwpro.globalforestwatch.org={{gfwpro_token}}

### Create a feature flag
GET https://localhost:8443/api/feature-flag
Content-Type: application/json
Cookie: gfwpro.globalforestwatch.org={{gfwpro_token}}
### ------------------------------
### env: development
### organization: DevCo
### modifierUser: 1692
### ------------------------------

{
	"flagId": "feature-flag",
	"orgId": null,
	"flagState": true,
	"modifierUserId": 1692 
}