{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["node", "express"]
  },
  "exclude": [
    "src/client/**/*",
    "**/*.test.js",
    "**/*.spec.js",
    "**/*.spec.jsx",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "include": ["**/*.ts", "**/*.js", "**/*.tsx", "**/*.jsx"]
}
