# Microsoft SQL Server Environment Variables.
MSSQL_HOSTNAME=<HOSTNAME>
MSSQL_DATABASE=<MAIN DATABASE NAME>
MSSQL_PORT=<DATABASE SERVER PORT>
MSSQL_USERNAME=<USERNAME>
MSSQL_PASSWORD=<PASSWORD>
MSSQL_LOG_DATABASE=<LOG DATABASE NAME>

# AWS Credentials
AWS_ACCESS_KEY_ID=<KEY ID>
AWS_SECRET_ACCESS_KEY=<SECRET ACCESS KEY>
AWS_REGION=<REGION>

# Used to set credentials for Cognito and App Authentication
COGNITO_USERPOOLID=<UserPoolId>
COGNITO_CLIENTID=<ClientId>
COGNITO_REGION=<Region>

# AWS SES Environment Variables.
SES_SENDER_EMAIL=<SenderEmail>

# AWS S3 Bucket Environment Variables.
BUCKET=<BuckettName>

#REDIS
REDIS_HOST=<REDIS_ENDPOINT>
REDIS_POR=<REDIS_PORT>

# AWS SQS URL
LOCATION_QUEUE_URL=<URL>
LIST_QUEUE_URL=<URL>

# AWS SNS TOPIC
SNS_TOPIC=<SNS TOPIC ARN>

# PLANET TILES CREDENTIALS
PLANET_TILES_API_KEY = <API_KEY>

# GFW data Api Key
GFW_DATA_API_KEY = <API_KEY>

B2B_MICROSERVICE_URL = <URL>
LISTS_MICROSERVICE_URL = <URL>