{
  "clearMocks": true,
  "collectCoverageFrom": ["<rootDir>/{client,config,server}/**/*.{js,jsx,ts,tsx}"],
  "coverageDirectory": "../../../coverage/apps/webserver",
  "coverageReporters": ["json", "text", "lcov", "clover", "cobertura"],
  "coverageThreshold": {
    "global": {
      "branches": 1,
      "functions": 1,
      "lines": 1,
      "statements": 1
    }
  },
  "moduleFileExtensions": ["js", "json", "jsx", "ts", "tsx"],
  "modulePathIgnorePatterns": [
    "<rootDir>/node_modules/",
    "<rootDir>/node_modules/@arcgis",
    "<rootDir>/dist/*"
  ],
  "setupFiles": ["@testing-library/react/dont-cleanup-after-each"],
  "setupFilesAfterEnv": ["./test/jest.setup.js", "@testing-library/jest-dom/extend-expect"],
  "testEnvironment": "jest-environment-jsdom",
  "testMatch": [
    "<rootDir>/client/**/*.test.js",
    "<rootDir>/server/**/*.spec.js",
    "<rootDir>/config/**/*.spec.js",
    "<rootDir>/test/fitness/**/*.test.js"
  ],
  "transform": {
    ".+\\.(css|css!|styl|less|sass|scss|png|jpg|ttf|woff|woff2)$": "jest-transform-stub",
    "^.+\\.(js|jsx)?$": "babel-jest",
    "^.+\\.(ts)$": "ts-jest"
  },
  "transformIgnorePatterns": ["node_modules/(?!(@arcgis|@esri|@stencil)/)"],
  "moduleNameMapper": {
    "^axios$": "/Users/richardblondet/Projects/wri.org/gfwpro/node_modules/axios/dist/node/axios.cjs",
    "^mapshaper$": "/Users/richardblondet/Projects/wri.org/gfwpro/node_modules/mapshaper/mapshaper.js",
    "\\.(css|scss)$": "<rootDir>/test/__mocks__/object.js",
    "\\.(jpe?g|png|gif|svg)$": "<rootDir>/test/__mocks__/object.js",
    "@arcgis/core/symbols/SimpleFillSymbol": "<rootDir>/test/__mocks__/SimpleFillSymbol.js",
    "@arcgis": "<rootDir>/test/__mocks__/object.js",
    "src/client/map/js/layers(.*)$": "<rootDir>/test/__mocks__/constructor.js",
    "map/js/layers/TreeCoverLossLayer": "<rootDir>/test/__mocks__/constructor.js",
    "^tests(.*)$": "<rootDir>/test/client/tests$1",
    "@wri-monorepos/constants": "<rootDir>/../../../libs/constants/src/index.ts",
