		block content

		script.
			var lo = document.getElementById('page-loading-indicator');
			if (lo) {
				var mo = new MutationObserver(function() { lo.style.display = 'none'; mo.disconnect(); });
				document.querySelectorAll('[id$="-mount"]').forEach(function(el) {
					mo.observe(el, { childList: true });
				});
				setTimeout(function() { lo.style.display = 'none'; }, 5000);
			}
