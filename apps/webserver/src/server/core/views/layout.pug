			if (window.location.pathname !== '/') {
				sessionCheck();
				document.addEventListener('click', function (event) {
					var sessionTimeout = window.sessionTimeout;
					var sessionInterval = window.sessionInterval;
					if (sessionTimeout) {
						clearTimeout(sessionTimeout);
					}
					if (sessionInterval) {
						clearInterval(sessionInterval);
					}
					sessionCheck();
				}, false);
				function sessionCheck() {
					window.sessionTimeout = setTimeout(function() {
						window.sessionInterval = setInterval(function() {
							var xhr = new XMLHttpRequest();
							xhr.onreadystatechange = function() {
								if (xhr.readyState == XMLHttpRequest.DONE) {
									if (xhr.status === 401) {
									window.location = '/';
									} else if ((xhr.responseText !== '' && xhr.responseText) && JSON.parse(xhr.responseText).redirect) {
										window.location = json.redirect;
									}
								}
							}
							xhr.open("POST", '/session', true);
							xhr.setRequestHeader('Content-Type', 'application/json');
							xhr.send(JSON.stringify({}));
						}, 60000); // Every 60 seconds...
					}, ((4 * 60 * 60 * 1000) + 300000)); // Every four hours + 5 minutes in ms
				}
			}
