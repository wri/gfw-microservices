  "version": "0.2.0",
  "configurations": [
    {      
      "name": "Webserver",
      "type": "node",
      "request": "attach",
      "websocketAddress": ""
    },
    {
      "name": "External API",
      "request": "launch",
      "type": "node",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "microservices-externalapi"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/apps/microservices/externalapi"
    },
    {
      "name": "List processing",
      "request": "launch",
      "type": "node",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "microservices-list-processing"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/apps/microservices/list-processing"
    }
  ]
}
