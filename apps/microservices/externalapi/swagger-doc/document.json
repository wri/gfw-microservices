  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "x-api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "ListAnalysisResponse": {
        "type": "object",
        "properties": {
          "listId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "errorsDetails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resultUrl": {
            "type": "string"
          },
          "creationDate": {
            "format": "date-time",
            "type": "string"
          },
          "expirationDate": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "listId",
          "status",
          "errorsDetails",
          "resultUrl",
          "creationDate",
          "expirationDate"
        ]
      },
      "BadRequestResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "enum": ["Bad Request"]
          }
        },
        "required": ["message"]
      },
      "UnauthorizedResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "enum": ["Unauthorized"]
          }
        },
        "required": ["message"]
      },
      "ForbiddenResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "enum": ["Forbidden"]
          }
        },
        "required": ["message"]
      },
      "ErroResponseWithErroMessage": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "enum": ["Not Found"]
          },
          "statusCode": {
            "type": "number"
          },
          "error": {
            "type": "string"
          }
        },
        "required": ["message", "statusCode", "error"]
      },
      "AlertsGenerateRequest": {
        "type": "object",
        "properties": {
          "startDate": {
            "format": "date-time",
            "type": "string",
            "example": "mm-dd-yyyy"
          },
          "endDate": {
            "format": "date-time",
            "type": "string",
            "example": "mm-dd-yyyy"
          },
          "userEmail": {
            "type": "string"
          }
        },
        "required": ["startDate", "endDate", "userEmail"]
      },
      "NotFoundResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "enum": ["Not Found"]
          },
          "statusCode": {
            "type": "number"
          }
        },
        "required": ["message", "statusCode"]
      },
      "InternalServerErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "enum": ["Internal Server Error"]
          }
        },
        "required": ["message"]
      },
      "requestEmailBody": {
        "type": "object",
        "properties": {
          "userEmail": {
            "type": "string"
          }
        },
        "required": ["userEmail"]
      },
      "DeleteListRequest": {
        "type": "object",
        "properties": {
          "userEmail": {
            "type": "string"
          }
        },
        "required": ["userEmail"]
      },
      "DeleteListMessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "enum": ["User 'email@email' has deleted list (listName)"]
          }
        },
        "required": ["message"]
      },
      "ListInfoResponse": {
        "type": "object",
        "properties": {
          "listId": {
            "type": "number"
          },
          "listName": {
            "type": "string"
          },
          "locationCount": {
            "type": "number"
          }
        },
        "required": ["listId", "listName", "locationCount"]
      },
      "ListUploadNewRequest": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string"
          },
          "listName": {
            "type": "string"
          },
          "templateId": {
            "type": "number"
          },
          "analysisIDs": {
            "type": "string"
          }
        },
        "required": ["uploadId", "listName", "templateId", "analysisIDs"]
      },
      "ListUploadNewResponse": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string"
          },
          "listId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "errorDetails": {
            "type": "string"
          },
          "creationDate": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["uploadId", "listId", "status", "errorDetails", "creationDate"]
      },
      "PrepareUploadRequest": {
        "type": "object",
        "properties": {
          "userEmail": {
            "type": "string"
          },
          "fileType": {
            "type": "string"
          }
        },
        "required": ["userEmail", "fileType"]
      },
      "PrepareUploadResponse": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string"
          },
          "uploadUrl": {
            "type": "string"
          },
          "uploadDateTime": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["uploadId", "uploadUrl", "uploadDateTime"]
      }
    }
  }
