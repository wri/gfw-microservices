{
  "compilerOptions": {
    "baseUrl": "../../../../",
    "paths": {
      "@wri-monorepos/aws": ["libs/aws/src/index.ts"],
      "@wri-monorepos/constants": ["libs/constants/src/index.ts"],
      "@wri-monorepos/feature-flags": ["libs/feature-flags/src/index.ts"],
      "@wri-monorepos/geo": ["libs/geo/src/index.ts"],
      "@wri-monorepos/shared": ["libs/shared/src/index.ts"],
      "@wri-monorepos/shared/utils/circuit-breaker": ["libs/shared/src/utils/circuit-breaker.ts"],
      "@wri-monorepos/shared/utils/retry": ["libs/shared/src/utils/retry.ts"],
      "@wri-monorepos/sql": ["libs/sql/src/index.ts"]
    },
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["**/*"]
}
