{
  "name": "sql",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/sql/src",
  "projectType": "library",
  "targets": {
    "prebuild": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/sql_cleanup/generate-orgs-sp-manifest.js"
      }
    },
    "build": {
      "dependsOn": ["prebuild"],
      "executor": "@nrwl/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/sql",
        "main": "libs/sql/src/index.ts",
        "tsConfig": "libs/sql/tsconfig.lib.json",
        "assets": ["libs/sql/*.md", "libs/sql/src/lib/queries/organization/orgs-sp-manifest.json"]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/sql/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/sql/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": []
}
