{
  "name": "gfwpro-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/gfwpro-e2e/cypress",
  "projectType": "application",
  "targets": {
    "e2e": {
      "executor": "@nrwl/cypress:cypress",
      "options": {
        "cypressConfig": "apps/gfwpro-e2e/cypress.config.ts",
        "testingType": "e2e"
      },
      "configurations": {
        "staging": {
          "baseUrl": "https://pro-staging.globalforestwatch.org",
          "env": {
            "deployment": "staging"
          }
        },
        "qa": {
          "baseUrl": "https://pro-qa.globalforestwatch.org",
          "env": {
            "deployment": "qa"
          }
        },
        "dev": {
          "baseUrl": "https://localhost:8443",
          "env": {
            "deployment": "dev"
          }
        }
      },
      "defaultConfiguration": "dev"
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/gfwpro-e2e/**/*.{js,ts}"]
      }
    }
  },
  "tags": [],
  "implicitDependencies": ["webserver"]
}
