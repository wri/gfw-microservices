{
  "name": "webserver",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/webserver/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "main": "apps/webserver/src/server.js",
        "outputPath": "dist/apps/webserver",
        "tsConfig": "apps/webserver/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/webserver/src/client/",
            "output": "apps/webserver/src/client/"
          },
          {
            "glob": "src/vectorTiles/.gitkeep",
            "input": "apps/webserver/",
            "output": "apps/webserver"
          },
          {
            "glob": "tsconfig.client.json",
            "input": "apps/webserver/",
            "output": "apps/webserver"
          },
          { "glob": "**/.babelrc", "input": "apps/webserver/", "output": "apps/webserver" },
          { "glob": "**/*.png", "input": "apps/webserver/", "output": "apps/webserver" },
          { "glob": "**/*.pug", "input": "apps/webserver/", "output": "apps/webserver" },
          { "glob": "**/*.key", "input": "apps/webserver/", "output": "apps/webserver" },
          { "glob": "**/*.crt", "input": "apps/webserver/", "output": "apps/webserver" }
        ],
        "platform": "node",
        "format": ["cjs"],
        "bundle": false,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "webserver:build",
        "runtimeArgs": ["--max-old-space-size=4096"],
        "runBuildTargetDependencies": true
      }
    },
    // "lint": {
    //   "executor": "@nrwl/linter:eslint",
    //   "outputs": ["{options.outputFile}"],
    //   "options": {
    //     "lintFilePatterns": ["apps/webserver/src/**/*.ts", "apps/webserver/src/**/*.js"]
    //   }
    // },
    "testweb": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/webserver"],
      "options": {
        "jestConfig": "apps/webserver/src/jest.config.json",
        "forceExit": true,
        "passWithNoTests": true,
        "testPathIgnorePatterns": ["test/fitness"],
        "verbose": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/webserver/src",
        "commands": ["node ./test/prepare-jest", "nx run webserver:testweb"],
        "verbose": true,
        "parallel": false
      }
    },
    "test-fitness-prep": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/webserver/src",
        "commands": [
          "rm -rf public/*",
          {
            "command": "NODE_OPTIONS=--max-old-space-size=4096 ts-node -T ../../../node_modules/webpack/bin/webpack.js --merge --config ./config/webpack.config.ts --config ./config/webpack.production.config.js",
            "forwardAllArgs": false
          },
          "node ./test/prepare-jest"
        ],
        "parallel": false
      }
    },
    "test-fitness-runner": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/webserver"],
      "options": {
        "jestConfig": "apps/webserver/src/jest.config.json",
        "forceExit": true,
        "passWithNoTests": true,
        "testPathPattern": ["test/fitness"],
        "verbose": true,
        "color": true
      }
    },
    "test-fitness": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/webserver/src",
        "commands": ["nx run test-fitness-prep", "nx run test-fitness-runner"],
        "parallel": false
      }
    }
  },
  "tags": []
}
