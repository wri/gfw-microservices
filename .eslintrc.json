{
  "root": true,
  "env": {
    "jest": true
  },
  "globals": {
    "gtag": "readonly",
    "Transifex": "readonly",
    "console": "readonly",
    "process": "readonly",
    "setTimeout": "readonly",
    "NodeJS": "readonly",
    "__dirname": "readonly",
    "fetch": "readonly",
    "Request": "readonly",
    "global": "readonly",
    "Buffer": "readonly"
  },
  "plugins": ["@nrwl/nx"],
  "overrides": [
    {
      "files": ["**/errorLogger.js", "**/errorLogger.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.spec.js",
        "**/*.spec.jsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.js",
        "**/*.test.jsx",
        "**/cypress/**/*"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {
        "@nrwl/nx/enforce-module-boundaries": [
          "error",
          {
            "enforceBuildableLibDependency": true,
            "allow": ["mssql", "sql"],
            "depConstraints": [
              {
                "sourceTag": "*",
                "onlyDependOnLibsWithTags": ["*"]
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["*.ts", "*.tsx"],
      "extends": ["plugin:@nrwl/nx/typescript", "eslint:recommended"],
      "rules": {
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": "error",
        "@typescript-eslint/no-non-null-assertion": "off",
        "no-console": "off"
      }
    },
    {
      "files": ["*.js", "*.jsx"],
      "extends": ["plugin:@nrwl/nx/javascript", "eslint:recommended"],
      "rules": {
        "no-unused-vars": "error",
        "no-console": "off"
      }
    },
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {
        "curly": ["error", "all"]
      }
    }
  ],
  "rules": {
    "max-len": [
      "error",
      {
        "code": 100,
        "tabWidth": 2,
        "ignoreComments": true,
        "ignoreUrls": true,
        "ignoreStrings": true,
        "ignoreTemplateLiterals": true
      }
    ]
  }
}
