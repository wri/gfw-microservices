{
  "name": "webserver",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/webserver/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/apps/webserver",
        "rootDir": "apps/webserver",
        "main": "apps/webserver/src/server.js",
        "outputFileName": "src/server.js",
        "tsConfig": "apps/webserver/tsconfig.app.json",
        "assets": [
          "**/tsconfig.client.json",
          "apps/webserver/src/vectorTiles/**",
          "apps/webserver/src/client/**",
          "apps/webserver/**/.babelrc",
          "apps/webserver/**/*.png",
          "apps/webserver/**/*.pug",
          "apps/webserver/**/*.key",
          "apps/webserver/**/*.crt"
        ]
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "webserver:build"
      }
    },
    "testweb": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/webserver"],
      "options": {
        "jestConfig": "apps/webserver/src/jest.config.json",
        "forceExit": true,
        "passWithNoTests": true,
        "testPathIgnorePatterns": ["test/fitness"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/webserver/src",
        "commands": [
          "node ./test/prepare-jest",
          {
            "command": "npx tsc ../../../libs/sql/src/lib/queries/index.ts --outDir ./queries",
            "forwardAllArgs": false
          },
          "nx run webserver:testweb"
        ],
        "parallel": false
      }
    },
    "test-fitness-prep": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/webserver/src",
        "commands": [
          "rm -rf public/*",
          {
            "command": "npx tsc ../../../libs/sql/src/lib/queries/index.ts --outDir ./queries",
            "forwardAllArgs": false
          },
          {
            "command": "node ../../../node_modules/webpack/bin/webpack.js --merge --config ./config/webpack.config.js --config ./config/webpack.production.config.js",
            "forwardAllArgs": false
          },
          "node ./test/prepare-jest"
        ],
        "parallel": false
      }
    },
    "test-fitness-runner": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/webserver"],
      "options": {
        "jestConfig": "apps/webserver/src/jest.config.json",
        "forceExit": true,
        "passWithNoTests": true,
        "testPathPattern": ["test/fitness"],
        "verbose": true,
        "color": true
      }
    },
    "test-fitness": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/webserver/src",
        "commands": ["nx run test-fitness-prep", "nx run test-fitness-runner"],
        "parallel": false
      }
    }
  },
  "tags": []
}
