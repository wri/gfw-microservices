extends ../../core/views/layout.pug
block head
  link(href=dashboardcss, rel='stylesheet')
block content
  div#dashboard-mount
  include ./svg.pug
  script.
    var userLists = !{JSON.stringify(userLists)};
    var locationCount = !{JSON.stringify(locationCount)};
    var accessLevel = !{JSON.stringify(accessLevel)};
    var subscription_status_id = !{JSON.stringify(subscription_status_id)};
    var gfwLists = !{JSON.stringify(gfwLists)};
    var userSharedLists = !{JSON.stringify(userSharedLists)};
    var fromMap = !{JSON.stringify(fromMap)};
    var listStatuses = !{JSON.stringify(listStatuses)};
    var userInfo = !{JSON.stringify(userInfo)};

  script(src=dashboardjs, async)
