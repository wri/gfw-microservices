### Get all feature flags for current organitzation
GET https://localhost:8443/api/feature-flags/myorg
Content-Type: application/json
Cookie: gfwpro.globalforestwatch.org={{gfwpro_token}}

### Get all feature flags records
GET https://localhost:8443/api/feature-flags
Content-Type: application/json
Cookie: gfwpro.globalforestwatch.org={{gfwpro_token}}

### Get feature flags rules by flagId
GET https://localhost:8443/api/feature-flags/Afi
Content-Type: application/json
Cookie: gfwpro.globalforestwatch.org={{gfwpro_token}}

### Insert or save a feature flag
POST https://localhost:8443/api/feature-flags
Content-Type: application/json
Cookie: gfwpro.globalforestwatch.org=s%3A0166ecf0-e91d-11ee-bfc4-55171210ec11.awy9Z817wzXPZrFmW94rOgHMeagVrjEpYGatyHd6Jas

{
	"flagId": "Afi",
	"orgId": 1,
	"flagState": true
}

### Delete feature flag row WHERE param :flagId and request.body.orgId
DELETE https://localhost:8443/api/feature-flags/Afi
Content-Type: application/json
Cookie: gfwpro.globalforestwatch.org={{gfwpro_token}}

{
	"orgId": 1
}
