		style.
			.osano-cm-window__widget {
				display: none; /* Hide osano cookie bubble */
			}
			.page-loading-indicator {
				display: flex;
				align-items: center;
				justify-content: center;
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background-color: rgba(0, 0, 0, 0.5);
				z-index: 9999;
			}
			.page-loading-spinner {
				width: 100px;
				height: 100px;
				animation: mui-rotate 1.4s linear infinite;
				opacity: 0.5;
			}
			.page-loading-spinner svg {
				display: block;
			}
			.page-loading-spinner circle {
				stroke: #97bd3d;
				stroke-dasharray: 80px, 200px;
				stroke-dashoffset: 0;
				animation: mui-dash 1.4s ease-in-out infinite;
			}
			@keyframes mui-rotate {
				100% { transform: rotate(360deg); }
			}
			@keyframes mui-dash {
				0% { stroke-dasharray: 1px, 200px; stroke-dashoffset: 0; }
				50% { stroke-dasharray: 100px, 200px; stroke-dashoffset: -15px; }
				100% { stroke-dasharray: 100px, 200px; stroke-dashoffset: -125px; }
			}
