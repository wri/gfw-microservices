{
  "name": "sql",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/sql/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nrwl/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/sql",
        "main": "libs/sql/src/index.ts",
        "tsConfig": "libs/sql/tsconfig.lib.json",
        "assets": ["libs/sql/*.md"]
      }
    },
    "makesql": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nx run sql:build && cp -r dist/libs/sql/src/lib/queries apps/webserver/src/queries"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/sql/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/sql/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": []
}
