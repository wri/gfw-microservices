# =======================================
# List name - webpack v5 test
# List ID - 2038
# Excluded columns - ['Location Name', 'Investment Name', 'Latitude', 'Longitude', 'Analysis Area', 'Analysis Radius', 'Commodity', 'Location Classification']
# =======================================

{
  "list_id": 2038,
  "attributes": [
    {"list_id": 100, "location_id": 30, "Type of Investment": "old investment", "Investment Name": "30"},
    {"list_id": 100, "location_id": 34, "Type of Investment": "renewal"},
    {"list_id": 100, "location_id": 42, "Type of Investment": "new investment"}
  ]
}
