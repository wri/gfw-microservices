extends ../../core/views/layout.pug
block head
  link(href=locationscss, rel='stylesheet')
  script(src=common)
  script(src='https://code.jquery.com/jquery-3.3.1.js')
block content
  div#locations-mount
  //- script(src=locationsjs, async)
  link(rel='stylesheet', href='https://js.arcgis.com/4.15/esri/css/main.css')
  include ./svg.pug
  script.
    var templateData = !{JSON.stringify(templateData)};
    var templateDropdowns = !{JSON.stringify(templateDropdowns)};
    var userLists = !{JSON.stringify(userLists)};
    var userSharedLists = !{JSON.stringify(userSharedLists)};
    var userInfo = !{JSON.stringify(userInfo)};
    var usersList = !{JSON.stringify(usersList)};
    var organizationId = !{JSON.stringify(organizationId)};
    var locationCount = !{JSON.stringify(locationCount)};
    var orgLists = !{JSON.stringify(orgLists)};
    var gfwLists = !{JSON.stringify(gfwLists)};
    var mapData = !{JSON.stringify(mapData)};
    var gfwData = !{JSON.stringify(gfwData)};
    var goToEditList = !{JSON.stringify(goToEditList)};
    var drawData = !{JSON.stringify(drawData)};
    var locationName = !{JSON.stringify(locationName)};
    var fromMap = !{JSON.stringify(fromMap)};
    var listStatuses = !{JSON.stringify(listStatuses)};
    var CURRENT_ENVIRONMENT = !{JSON.stringify(CURRENT_ENVIRONMENT)};
    var subscription_status_id = !{JSON.stringify(subscriptionStatus)};
    // Set the user ID using signed-in user_id.
    gtag('set', { 'user_id': userInfo.email });

  script(src='https://js.arcgis.com/4.15/', async)
  script(src='https://dpptfqp76xood.cloudfront.net/js/ionRange.js')
  script.
    var makePath = function(base, path) {
      var position = base.length - 1;
      return !path ?
        (base.indexOf('/', position) !== position ? base + '/' : base) :
        (base.indexOf('/', position) !== position ?
            base + '/' + path :
            base + path
        )
    };
    var base = makePath(location.href.replace(/\/[^/]+$/, ''));
    var dojoConfig = {
      parseOnLoad: false,
      async: true,
      has: {
        "esri-promise-compatibility": 1
      },
      packages: [
        { name: 'common', location: makePath(base, 'common') }
      ],
      deps: ['dojo/domReady!'],
      callback: function() {
        require(['#{locationsjs}']);
      }
    };
