### Update Account Information
POST https://localhost:8443/pro-manager/updateProAccount
Content-Type: application/json
Cookie: gfwpro.globalforestwatch.org={{gfwpro_token}}
# =======================================
# NODE_ENV=development  
# dbo.Organizations
# id=86
# =======================================

{
  "id": 86,
  "org_name": "WRICONSULTANT",
  "org_address": "Ethereal St",
  "org_website": "https://wriconsultant.org",
  "parent_org_name": "",
  "is_subsidiary": false,
  "arr_org_classification_ids": [4],
  "policyUploadList": [],
  "policyName": [],
  "subscription_status_id": 1
}

### Update Global Analysis Limits
POST https://localhost:8443/pro-manager/updateGlobalAnalysisLimits
Content-Type: application/json
Cookie: gfwpro.globalforestwatch.org={{gfwpro_token}}
# =======================================
# NODE_ENV=development  
# dbo.AnalysisLimits
# subscriptionStatusId=1
# =======================================

{
  "subscriptionStatusId": 1,
  "MaxAreaAnalyzeablePerYear": 1998,
  "MaxAreaPerList": 18
}

### Update Account Analysis Limits
POST https://localhost:8443/pro-manager/updateAccountAnalysisLimits
Content-Type: application/json
Cookie: gfwpro.globalforestwatch.org={{gfwpro_token}}
# =======================================
# NODE_ENV=development  
# dbo.AnalysisLimits
# organizationId=1
# =======================================

{
  "organizationId": 1,
  "MaxAreaAnalyzeablePerYear": 15000,
  "MaxAreaPerList": 37
}
