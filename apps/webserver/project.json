{
  "name": "webserver",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/webserver/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "main": "apps/webserver/src/server.js",
        "outputPath": "dist/apps/webserver",
        "tsConfig": "apps/webserver/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/webserver/src/config/",
            "output": "apps/webserver/config/"
          },
          {
            "glob": "**/*",
            "input": "apps/webserver/src/client/",
            "output": "apps/webserver/src/client/"
          },
          {
            "glob": "src/vectorTiles/.gitkeep",
            "input": "apps/webserver/",
            "output": "apps/webserver"
          },
          {
            "glob": "client/tsconfig.json",
            "input": "apps/webserver/",
            "output": "apps/webserver"
          },
          { "glob": "**/.babelrc", "input": "apps/webserver/", "output": "apps/webserver" },
          { "glob": "**/*.png", "input": "apps/webserver/", "output": "apps/webserver" },
          { "glob": "**/*.pug", "input": "apps/webserver/", "output": "apps/webserver" },
          { "glob": "**/*.key", "input": "apps/webserver/", "output": "apps/webserver" },
          { "glob": "**/*.crt", "input": "apps/webserver/", "output": "apps/webserver" }
        ],
        "platform": "node",
        "format": ["cjs"],
        "bundle": false,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "development": {
          "bundle": true,
          "sourcemap": false,
          "minify": false
        },
        "production": {
          "minify": true
        }
      }
    },
    "serve": {
      "dependsOn": ["build"],
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "webserver:build",
        "runtimeArgs": ["--max-old-space-size=4096"],
        "watch": true
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "apps/webserver/src/client/**/*.{ts,js,tsx,jsx}",
          "apps/webserver/src/server/**/*.{ts,js}"
        ]
      }
    },
    "testweb": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/webserver"],
      "options": {
        "jestConfig": "apps/webserver/src/jest.config.json",
        "forceExit": true,
        "passWithNoTests": true,
        "testPathIgnorePatterns": ["test/fitness"],
        "verbose": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/webserver/src",
        "commands": ["NODE_OPTIONS=--max-old-space-size=4096 nx run webserver:testweb"],
        "verbose": true,
        "parallel": false
      }
    },
    "test-fitness-prep": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/webserver/src",
        "commands": ["echo 'no test fitness prep required'"],
        "parallel": false
      }
    },
    "test-fitness-runner": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/webserver"],
      "options": {
        "jestConfig": "apps/webserver/src/jest.config.json",
        "forceExit": true,
        "passWithNoTests": true,
        "testPathPattern": ["test/fitness"],
        "verbose": true,
        "color": true
      }
    },
    "test-fitness": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/webserver/src",
        "commands": ["nx run test-fitness-prep", "nx run test-fitness-runner"],
        "parallel": false
      }
    }
  },
  "tags": []
}
