# ?geostoreID
# ?sum
POST https://localhost:8443/dataApi/analysisTreeCoverGain/?geostore_origin=rw&geostoreID=c1d38a77304621cb887b9b0041522b54&sum=area__ha
Content-Type: application/json
Cookie: gfwpro.globalforestwatch.org={{gfwpro_token}}

