extends ../../core/views/layout.pug
block head
  link(href=dashboardcss, rel='stylesheet')
  script(src=common)
block content
  div#dashboard-mount
  link(rel='stylesheet', href='https://js.arcgis.com/4.6/esri/css/main.css')
  include ./svg.pug
  script.
    var userLists = !{JSON.stringify(userLists)};
    var locationCount = !{JSON.stringify(locationCount)};
    var accessLevel = !{JSON.stringify(accessLevel)};
    var subscription_status_id = !{JSON.stringify(subscription_status_id)};
    var gfwLists = !{JSON.stringify(gfwLists)};
    var userSharedLists = !{JSON.stringify(userSharedLists)};
    var fromMap = !{JSON.stringify(fromMap)};
    var listStatuses = !{JSON.stringify(listStatuses)};
    var userInfo = !{JSON.stringify(userInfo)};

  script(src='https://js.arcgis.com/4.6/', async)
  script.
    function makePath (base, path) {
      var position = base.length - 1;
      return !path ?
        (base.indexOf('/', position) !== position ? base + '/' : base) :
        (base.indexOf('/', position) !== position ?
          base + '/' + path :
          base + path
        )
    };
    var base = makePath(location.href.replace(/\/[^/]+$/, ''));
    var dojoConfig = {
      parseOnLoad: false,
      async: true,
      has: {
        "esri-promise-compatibility": 1,
        "esri-featurelayer-webgl": 1
      },
      packages: [
        { name: 'common', location: makePath(base, 'common') }
      ],
      deps: ['dojo/domReady!'],
      callback: function(){
        require(['#{dashboardjs}']);
      }
    };
